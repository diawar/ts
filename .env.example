DJANGO_SECRET_KEY=replace-with-generated-secret
POSTGRES_PASSWORD=replace-with-generated-password
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=replace-with-random-password-at-least-16-characters
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
WEB_PORT=8000
# Permanent public origin for canonical links and sitemap, e.g. https://example.kz
# Leave empty to use the current request host until a domain is connected.
PUBLIC_SITE_URL=https://tender-search.kz

# Trusted origin for auth email links; separate from the future SEO domain.
# Set to your actual local WEB_PORT. Tunnel service overrides this automatically.
AUTH_SITE_URL=http://localhost:8000
# Default: local-only Mailpit inbox at http://localhost:8025 (no external delivery).
# For real delivery configure your SMTP provider, sender and TLS/SSL below.
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=TenderSearch <no-reply@tender-search.kz>

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Disable only on development copies sharing the production bot.
TELEGRAM_POLLING_ENABLED=true
