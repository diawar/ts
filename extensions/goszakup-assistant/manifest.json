{
  "manifest_version": 3,
  "name": "Госзакупки — помощник черновиков",
  "version": "0.17.0",
  "description": "Подготовка черновика ЗЦП и проверка статуса. Без подписания и подачи.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/lots/*/preparation/*",
        "http://127.0.0.1/lots/*/preparation/*",
        "http://localhost/workspace/drafts/",
        "http://127.0.0.1/workspace/drafts/"
      ],
      "js": [
        "bridge-config.js",
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://zakup.gov.kz/*"
  ]
}
